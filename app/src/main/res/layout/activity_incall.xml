<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <!-- Main call content -->
    <LinearLayout
        android:id="@+id/callContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <!-- Caller info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_avatar">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/avatar_on" />
            </FrameLayout>

            <TextView
                android:id="@+id/callerNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/on_surface"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="+91 98765 43210" />

            <TextView
                android:id="@+id/callState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/on_surface_muted"
                android:textSize="15sp"
                tools:text="Dialing…" />

            <TextView
                android:id="@+id/callTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="00:42" />

            <TextView
                android:id="@+id/secondCallHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="1 call on hold in background" />
        </LinearLayout>

        <!-- Ongoing-call controls -->
        <LinearLayout
            android:id="@+id/ongoingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/ControlColumn">
                    <ImageButton
                        android:id="@+id/addCallButton"
                        style="@style/ControlButton"
                        android:contentDescription="@string/call"
                        android:src="@drawable/ic_add_call"
                        app:tint="@color/on_surface" />
                    <TextView style="@style/ControlLabel" android:text="@string/call" />
                </LinearLayout>

                <LinearLayout style="@style/ControlColumn">
                    <ImageButton
                        android:id="@+id/holdButton"
                        style="@style/ControlButton"
                        android:contentDescription="@string/hold"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/on_surface" />
                    <TextView style="@style/ControlLabel" android:text="@string/hold" />
                </LinearLayout>

                <LinearLayout style="@style/ControlColumn">
                    <ImageButton
                        android:id="@+id/keypadButton"
                        style="@style/ControlButton"
                        android:contentDescription="@string/keypad"
                        android:src="@drawable/ic_dialpad"
                        app:tint="@color/on_surface" />
                    <TextView style="@style/ControlLabel" android:text="@string/keypad" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/ControlColumn">
                    <ImageButton
                        android:id="@+id/speakerButton"
                        style="@style/ControlButton"
                        android:contentDescription="@string/speaker"
                        android:src="@drawable/ic_speaker"
                        app:tint="@color/on_surface" />
                    <TextView style="@style/ControlLabel" android:text="@string/speaker" />
                </LinearLayout>

                <LinearLayout style="@style/ControlColumn">
                    <ImageButton
                        android:id="@+id/muteButton"
                        style="@style/ControlButton"
                        android:contentDescription="@string/mute"
                        android:src="@drawable/ic_mic_off"
                        app:tint="@color/on_surface" />
                    <TextView style="@style/ControlLabel" android:text="@string/mute" />
                </LinearLayout>

                <LinearLayout style="@style/ControlColumn">
                    <ImageButton
                        android:id="@+id/addContactButton"
                        style="@style/ControlButton"
                        android:contentDescription="@string/add_to_contacts"
                        android:src="@drawable/ic_person"
                        app:tint="@color/on_surface" />
                    <TextView style="@style/ControlLabel" android:text="@string/tab_contacts" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/hangupButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_reject_button"
                android:contentDescription="@string/hang_up"
                android:src="@drawable/ic_call_end"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Incoming-call controls -->
        <LinearLayout
            android:id="@+id/incomingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/rejectButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_reject_button"
                    android:contentDescription="@string/reject"
                    android:src="@drawable/ic_call_end"
                    app:tint="@color/white" />

                <TextView style="@style/ControlLabel" android:text="@string/reject" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/answerButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_call_button"
                    android:contentDescription="@string/answer"
                    android:src="@drawable/ic_call"
                    app:tint="@color/white" />

                <TextView style="@style/ControlLabel" android:text="@string/answer" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- DTMF keypad overlay -->
    <LinearLayout
        android:id="@+id/dtmfOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dtmfDisplay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="start"
            android:textColor="@color/on_surface"
            android:textSize="30sp"
            tools:text="1234" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <LinearLayout android:id="@+id/dtmf_1" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_2" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_3" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_4" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="4" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_5" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="5" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_6" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="6" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_7" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="7" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_8" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="8" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_9" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="9" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_star" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="*" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_0" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="0" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dtmf_hash" style="@style/DialKey">
                <TextView style="@style/DialKeyNumber" android:text="#" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:id="@+id/dtmfHide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/hide_keypad"
            android:textColor="@color/accent"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
